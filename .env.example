# ── 运行时 ──────────────────────────────────────────────────────
# 生产用 production；反向代理到本端口
NODE_ENV=development
PORT=3001

# ── 数据库 ──────────────────────────────────────────────────────
# MySQL 连接串；首次部署先 pnpm db:push 建表
DATABASE_URL=mysql://user:pass@127.0.0.1:3306/lixin_epower

# ── 本站密钥 ────────────────────────────────────────────────────
# 用于派生「凭据 AES-256-GCM 加密」用的密钥。
# 用 openssl rand -base64 32 生成；改了会导致已存的加密凭据无法解密。
APP_ID=selfhost
APP_SECRET=

# ── 共用课表站会话（SSO）─────────────────────────────────────────
# 填课表站的 APP_SECRET，用于验签它签发的 JWT（cookie: lixin_jw_sid）。
# 必须与课表站的 APP_SECRET 完全一致，否则全员掉线。
# 注意：这是与上面 APP_SECRET 不同的另一把密钥，别填成同一个值。
SSO_SECRET=

# 这些学号登录后自动成为管理员（逗号分隔），可看全部宿舍与全局设置
# 会话 cookie 的 Domain。必须与课表站的 COOKIE_DOMAIN 完全一致，
# 否则「退出登录」删不掉那个共享 cookie（浏览器按 name+domain+path 匹配）。
# 不配也能跑：会从请求的 Host 推（epower.example.com → .example.com）。
COOKIE_DOMAIN=

# 松江校内采集端的共享 token（采集脚本用它向本站推送读数）
# 生成：openssl rand -base64 24 | tr -d "+/="
INGEST_TOKEN=

ADMIN_STUDENT_IDS=
